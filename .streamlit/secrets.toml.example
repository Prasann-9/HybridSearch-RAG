# Copy to `.streamlit/secrets.toml` and fill real values for LOCAL runs.
# On Streamlit Community Cloud, paste these into Settings → Secrets instead.
# Optional — learners can also paste their own keys into the sidebar at runtime.
#
# Keep only the keys your app's PROVIDERS registry (core/keys.py) actually uses.

# Groq (free) — https://console.groq.com/keys
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google Gemini (free) — https://aistudio.google.com/apikey
GEMINI_API_KEY = "AIza_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Tavily (free tier) — https://app.tavily.com
TAVILY_API_KEY = "tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
